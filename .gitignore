# =============================================================
#  .gitignore — ImmoTuléar (Racine du projet)
# =============================================================

# Dépendances Node.js (JAMAIS dans Git)
node_modules/
*/node_modules/
package-lock.json.bak
.npm/
.npm-cache/
.pnpm-store/

# Environnements & Secrets (JAMAIS dans Git)
.env
.env.*
.env.local
.env.production
.env.development
!.env.example
!.env.production.example

# Builds & Distributions
dist/
dist-ssr/
build/
*/dist/
out/

# Uploads dynamiques et médias utilisateurs
uploads/*
*/uploads/*
!uploads/.gitkeep
!*/uploads/.gitkeep

# Bases de données locales & SQLite / Prisma
*.db
*.db-journal
*.sqlite
prisma/*.db
prisma/*.db-journal

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Fichiers système & Éditeurs
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Docker local data (au cas où monté en local)
data/
pg_data/
