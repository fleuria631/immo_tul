{
  "name": "immotulear-backend",
  "version": "1.0.0",
  "description": "Backend API pour ImmoTuléar - Agence immobilière à Toliara, Madagascar",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "npx prisma generate && npx prisma migrate deploy",
